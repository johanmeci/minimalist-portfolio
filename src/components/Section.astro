---
const { title, id } = Astro.props;
---

<section id={id}>
  <header class="section-header" data-reveal>
    <div class="icon-container"><slot name="icon" /></div>
    {title && <h2>{title}</h2>}
  </header>
  <slot />
</section>

<style>
  section {
    max-width: 700px;
    margin: 0 auto;
    padding-top: var(--section-pad-top, 3.5rem);
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--border-color);
    position: relative;
  }

  :global(.dark) section {
    border-bottom-color: #3c4144;
  }

  section:nth-child(1) {
    padding-top: 0;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
  }

  .icon-container {
    display: flex;
    align-items: center;
    color: var(--text-muted);
  }

  h2 {
    font-weight: 600;
    line-height: 1.3;
    font-size: 1.6rem;
    letter-spacing: 0;
  }
</style>
