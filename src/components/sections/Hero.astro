---
import { basics } from "@cv";
import Section from "@/components/Section.astro";
import WorldMap from "@/icons/WorldMap.astro";
import Mail from "@/icons/Mail.astro";
import GitHub from "@/icons/GitHub.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import CV from "@/icons/CV.astro";
import ThemeIcon from "../ThemeIcon.astro";

const { name, label, location, profiles, email } = basics;
const { city, region } = location;

const SOCIAL_ICONS: Record<string, any> = {
  GitHub,
  LinkedIn,
  CV,
};

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn");
const linkedUrl = linkedInfo?.url;

const printInfo = [email, linkedUrl].filter(Boolean).join(" • ");
---

<Section>
  <div class="container">
    <div class="info">
      <h1 data-reveal>{name}</h1>
      <h2 data-reveal style="--reveal-index: 1">{label}</h2>
      <span class="location" data-reveal style="--reveal-index: 2">
        <WorldMap />
        {region}
      </span>
      <footer class="print">
        {printInfo}
      </footer>
      <footer class="social-links" data-reveal style="--reveal-index: 3">
        {
          email && (
            <a
              href={`mailto:${email}`}
              title={`Send an email to ${name} at ${email}`}
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-event="contact_click"
              data-analytics-label="email"
              data-analytics-location="hero"
            >
              <Mail />
            </a>
          )
        }
        {
          profiles.map(({ network, url }) => {
            const Icon = SOCIAL_ICONS[network];
            return (
              <a
                href={url}
                title={
                  network === "CV"
                    ? `Download ${name}'s CV`
                    : `Visit ${name}'s ${network} profile`
                }
                target="_blank"
                rel="noopener noreferrer"
                download={network === "CV" ? `Johan_Meneses_CV.pdf` : undefined}
                data-analytics-event={network === "CV" ? "cv_download_click" : "social_click"}
                data-analytics-label={network.toLowerCase()}
                data-analytics-location="hero"
              >
                <Icon />
              </a>
            );
          })
        }
        <ThemeIcon />
      </footer>
      <p class="cmdk-hint" data-reveal style="--reveal-index: 4">
        Press <kbd>⌘</kbd><kbd>K</kbd> for quick actions
      </p>
    </div>
    <div class="polaroid-wrap" data-reveal style="--reveal-index: 5">
      <figure class="profile-image">
        <img
          src="/assets/johan_profile.jpg"
          alt={`${name} - ${label} professional headshot`}
          loading="eager"
          width="190"
          height="240"
        />
      </figure>
    </div>
  </div>
</Section>

<style>
  .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0 1rem;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-right: 32px;
  }

  h1 {
    font-size: clamp(2.75rem, 6vw, 3.75rem);
    color: var(--text-primary);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 700;
    text-wrap: balance;
  }

  h2 {
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 1.25rem;
    text-wrap: balance;
    margin: 0;
  }

  .polaroid-wrap {
    position: relative;
  }

  .polaroid-wrap::before {
    content: "";
    position: absolute;
    top: -7px;
    left: 50%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%,
      hsl(0 80% 68%),
      hsl(0 70% 48%) 55%,
      hsl(0 75% 38%));
    box-shadow: 0 2px 3px hsl(214 30% 20% / 0.35);
    transform: translateX(-50%);
    z-index: 1;
  }

  .profile-image {
    margin: 0;
    padding: .5rem .5rem 1.5rem .5rem;
    background-color: white;
    border: 1px solid var(--border-color);
    box-shadow: 0 3px 8px hsl(214 30% 20% / 0.18);
    transform: rotate(-3deg);
    transform-origin: 50% 0;
    animation: polaroid-swing-back 1.1s ease-in-out forwards;
    &:hover {
      animation: polaroid-swing 1.1s ease-in-out forwards;
    }
  }

  @keyframes polaroid-swing {
    0% { transform: rotate(-1deg); }
    20% { transform: rotate(3.5deg); }
    40% { transform: rotate(-2.2deg); }
    58% { transform: rotate(1.4deg); }
    74% { transform: rotate(-0.8deg); }
    88% { transform: rotate(0.3deg); }
    100% { transform: rotate(0deg); }
  }

  @keyframes polaroid-swing-back {
    0% { transform: rotate(0deg); }
    20% { transform: rotate(-3.5deg); }
    40% { transform: rotate(2.2deg); }
    58% { transform: rotate(-1.4deg); }
    74% { transform: rotate(0.8deg); }
    88% { transform: rotate(-0.3deg); }
    100% { transform: rotate(-1deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-image,
    .profile-image:hover {
      animation: none;
    }
  }

  img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: top;
    width: 142px;
    height: 149px;
    border-radius: 0;
    transition: transform 0.2s ease;
  }

  .location {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .social-links {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .cmdk-hint {
    position: absolute;
    bottom: 10px;
    left: 2px;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.25rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .cmdk-hint kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.4rem;
    height: 1.4rem;
    padding: 0 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-bottom-width: 2px;
    border-radius: 4px;
  }

  @media (max-width: 768px) {
    .cmdk-hint {
      display: none;
    }
  }

  .social-links a {
    color: var(--chip-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    background-color: var(--chip-bg);
    padding: 4px;
    height: 32px;
    width: 32px;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .social-links a:hover {
    transform: translateY(-3px);
    box-shadow: var(--card-shadow);
    text-decoration: none;
  }

  .social-links a:active {
    transform: translateY(-1px) scale(0.96);
  }

  @media screen and (max-width: 768px) {
    .container {
      flex-direction: column;
    }
    .container .info {
      order: 1;
      padding-right: 0;
      text-align: center;
    }
    .location {
      margin: auto;
    }
    .social-links {
      justify-content: center;
    }
    .container figure {
      order: 0;
    }
    h1 {
      font-size: 2rem;
    }
    h2 {
      font-size: 1.1rem;
    }
  }

  .print {
    display: none;
  }

  @media print {
    .info {
      padding-right: 0;
    }

    .social-links,
    .cmdk-hint {
      display: none;
    }

    .print {
      display: block;
      color: #000;
      margin-top: 0.5rem;
    }
  }
</style>
