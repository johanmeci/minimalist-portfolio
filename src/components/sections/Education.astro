---
import Section from "../Section.astro";
import EducationIcon from "@/icons/EducationIcon.astro";

import { education } from "@cv";
---

<Section title="Education" id="education">
  <EducationIcon slot="icon" />
  <ul>
    {
      (education || [])
        .sort((a, b) => {
          const aTime = a.endDate
            ? new Date(a.endDate).getTime()
            : new Date().getTime();
          const bTime = b.endDate
            ? new Date(b.endDate).getTime()
            : new Date().getTime();
          return bTime - aTime;
        })
        .map(({ institution, startDate, endDate, area }, index) => {
          const startYear = startDate
            ? new Date(startDate).getFullYear()
            : null;
          const endYear = endDate ? new Date(endDate).getFullYear() : "Actual";
          const sameYear = startYear === endYear;

          return (
            <li data-reveal style={`--reveal-index: ${index}`}>
              <article>
                <header>
                  <div>
                    <h3>{institution}</h3>
                  </div>
                  <span class="years">
                    {startYear && !sameYear && (
                      <>
                        <time datetime={String(startYear)}>{startYear}</time>
                        {" - "}
                      </>
                    )}
                    {endDate ? (
                      <time datetime={String(endYear)}>{endYear}</time>
                    ) : (
                      <span>{endYear}</span>
                    )}
                  </span>
                </header>
                <footer>
                  <p>{area}</p>
                </footer>
              </article>
            </li>
          );
        })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 700;
    color: var(--text-primary);
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  .years,
  time {
    color: var(--text-muted);
    font-size: 0.9rem;
    min-width: 102px;
    text-align: right;
    padding-right: 0.5rem;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }
</style>
