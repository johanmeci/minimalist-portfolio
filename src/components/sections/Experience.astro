---
import Section from "../Section.astro";
import ExperienceIcon from "@/icons/ExperienceIcon.astro";

import { work } from "@cv";
---

<Section title="Experience" id="experience">
  <ExperienceIcon slot="icon" />
  <ul>
    {
      (work || []).map(({ name, startDate, endDate, position, summary }, index) => {
        const startYear = startDate ? new Date(startDate).getFullYear() : null;
        const endYear = endDate ? new Date(endDate).getFullYear() : "Present";

        return (
          <li data-reveal style={`--reveal-index: ${index}`}>
            <article>
              <header>
                <div>
                  <h3>{name}</h3>
                  <p>{position}</p>
                </div>
                <span class="years">
                  {startYear && <time datetime={String(startYear)}>{startYear}</time>}
                  {startYear && " - "}
                  {endDate ? (
                    <time datetime={String(endYear)}>{endYear}</time>
                  ) : (
                    <span>{endYear}</span>
                  )}
                </span>
              </header>

              <footer>
                <p>{summary}</p>
              </footer>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    li {
      border: 1px solid var(--border-color);
      padding: 1rem;
      border-radius: 5px;
      background-color: #ffffff;
      transition: border-color 180ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
      &:hover {
        border-color: color-mix(in srgb, var(--text-primary), transparent 60%);
      }
    }
  }

  :global(.dark) li {
    background-color: var(--bg-primary);
    &:hover {
      border-color: color-mix(in srgb, var(--text-primary), transparent 70%);
    }
  }

  article h3 {
    font-size: 1.3rem;
    margin-bottom: 0.3rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  article h4 {
    color: var(--text-secondary);
    font-weight: 400;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.8rem;
  }

  footer p {
    white-space: pre-line;
  }

  .years,
  time {
    font-size: 0.9rem;
  }
</style>
