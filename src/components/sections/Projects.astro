---
import Section from "../Section.astro";
import ProjectsIcon from "@/icons/ProjectsIcon.astro";
import ArrowIcon from "@/icons/ArrowIcon.astro";

import { projects } from "@cv";
---

<Section title="Projects" id="projects">
  <ProjectsIcon slot="icon" />
  <ul>
    {
      (projects || []).map(
        ({ url, description, links, name, image, technologies, status, slug }, index) => {
          return (
            <li data-reveal style={`--reveal-index: ${index % 3}`}>
              <article>
                <header>
                  <h3 transition:name={slug ? `${slug}-title` : undefined}>
                    <a
                      href={url}
                      title={`View project ${name}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-analytics-event="project_click"
                      data-analytics-label={name}
                      data-analytics-location="projects_title"
                    >
                      {name}
                      <ArrowIcon />
                    </a>
                  </h3>
                  {image && (
                    <img
                      src={image}
                      alt={`${name} project screenshot`}
                      loading="lazy"
                      transition:name={slug ? `${slug}-image` : undefined}
                    />
                  )}
                  <p>{description}</p>
                </header>
                <footer>
                  <div class="container-technologies">
                    {(technologies || []).map((technology) => {
                      return (
                        <span>
                          <img
                            src={`/assets/icons/${technology}-icon.svg`}
                            alt={`${technology} technology icon`}
                            width="16"
                            height="16"
                            loading="lazy"
                          />
                          {technology !== "gsap" && technology}
                        </span>
                      );
                    })}
                  </div>
                  <div class="container-links">
                    {(links || []).map((link) => {
                      return (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          data-analytics-event="project_link_click"
                          data-analytics-label={`${name}:${link.label}`}
                          data-analytics-location="projects_footer"
                        >
                          {link.label}
                        </a>
                      );
                    })}
                    {slug && (
                      <a
                        href={`/projects/${slug}`}
                        class="details-link"
                        data-analytics-event="project_details_click"
                        data-analytics-label={name}
                        data-analytics-location="projects_footer"
                      >
                        Details →
                      </a>
                    )}
                  </div>
                  {status && <span class="status">{status}</span>}
                </footer>
              </article>
            </li>
          );
        },
      )
    }
  </ul>
</Section>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    grid-auto-rows: 1fr;
    gap: 1.5rem 1.25rem;
  }

  article {
    background-color: var(--bg-primary);
    border-radius: 10px;
    border: 1px solid var(--border-color);
    gap: 5px;
    display: flex;
    flex-direction: column;
    padding: 16px;
    height: 100%;
    transition:
      transform 180ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
      box-shadow 180ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  article:hover {
    transform: translateY(-3px);
    box-shadow: 0 3px 12px hsl(214 30% 25% / 0.12);
  }

  article:active {
    transform: translateY(-1px) scale(0.99);
  }

  :global(.dark) article {
    border-color: var(--border-color);
    background-color: var(--bg-primary);
  }

  :global(.dark) article:hover {
    box-shadow: var(--card-shadow);
  }

  article header {
    flex: 1;
    img {
      object-fit: cover;
      object-position: top;
      width: 100%;
      aspect-ratio: 16 / 10;
      border-radius: 4px;
      margin-bottom: 0.5rem;
    }
  }

  article h3 {
    margin-bottom: 0.8rem;
    a {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--text-primary);
      svg {
        width: 1.1rem;
        height: 1.1rem;
      }
    }
  }

  article a {
    color: var(--text-primary);
    transition: transform 150ms ease;
  }

  article a:active {
    transform: scale(0.98);
  }

  article a:hover {
    text-decoration: underline;
  }

  article p {
    font-size: 0.85rem;
    line-height: 1.4rem;
    margin-bottom: 0.8rem;
  }

  article footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.7rem;
    position: relative;
    .status {
      position: absolute;
      bottom: 0;
      left: 0;
      padding-left: 0.5rem;
      &::after {
        content: "";
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background-color: var(--accent-color);
        position: absolute;
        top: 45%;
        left: 0;
        transform: translateY(-45%);
      }
    }
  }

  article footer a {
    border-radius: 6px;
    background-color: var(--chip-soft-bg);
    color: var(--chip-soft-text);
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    text-decoration: none;
  }

  article footer a:hover {
    background-color: color-mix(in srgb, var(--chip-soft-bg), var(--chip-soft-text) 12%);
  }

  article footer a.details-link {
    background-color: color-mix(in srgb, var(--accent-color) 12%, transparent);
    color: var(--accent-color);
    border: 1px solid color-mix(in srgb, var(--accent-color) 35%, transparent);
  }

  article footer .container-technologies,
  article footer .container-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    width: 100%;
  }

  article footer .container-technologies {
    align-items: center;
    gap: 0.5rem;
    span {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      line-height: 1;
      text-transform: capitalize;
      font-size: 0.7rem;
      border: 1px solid color-mix(in srgb, var(--chip-bg), transparent 60%);
      padding: 0.3rem 0.4rem;
      height: 1.6rem;
      border-radius: 0.25rem;
      background-color: var(--chip-bg);
      color: var(--chip-text);
    }
  }

  article footer .container-links {
    margin-top: 1rem;
    justify-content: flex-end;
  }

  @media print {
    article {
      header {
        img {
          display: none;
        }
      }
      footer {
        .container-links {
          display: none;
        }
      }
    }
  }
</style>
