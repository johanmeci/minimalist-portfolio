---
import Sun from "@/icons/Sun.astro";
import Moon from "@/icons/Moon.astro";
import Monitor from "@/icons/Monitor.astro";
---

<button id="themeToggle" aria-label="Cycle theme" title="Theme: system">
  <Sun class="sun" id="sun" />
  <Moon class="moon" id="moon" />
  <Monitor class="system" id="system" />
</button>

<style>

  #themeToggle {
    border: 0;
    cursor: pointer;
    border-radius: 5px;
    width: 32px;
    height: 32px;
    transition: transform 180ms cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 180ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
    &:hover {
      transform: translateY(-3px);
    }
    &:focus-visible {
      outline: 2px solid var(--accent-color, hsl(214 38% 55%));
      outline-offset: 2px;
    }
  }

  :global(.dark) #themeToggle:hover {
    box-shadow: var(--card-shadow);
  }

  .sun, .moon, .system {
    animation: scale-up-center 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    width: 100%;
    height: 100%;
  }

  .sun { display: none; }
  .moon { display: block; }
  .system { display: none; }

  /* Icon reflects the chosen mode; Layout sets data-theme-choice before paint */
  :global(html[data-theme-choice="dark"]) .sun { display: block; }
  :global(html[data-theme-choice="dark"]) .moon { display: none; }

  :global(html[data-theme-choice="system"]) .moon { display: none; }
  :global(html[data-theme-choice="system"]) .system { display: block; }

  @keyframes scale-up-center {
    from {
      transform: scale(0.8);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @media print {
    #themeToggle {
      display: none;
    }
  }

</style>

<script is:inline>
  (() => {
    const ORDER = ["light", "dark", "system"];

    const applyTheme = (choice) => {
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const dark = choice === "dark" || (choice === "system" && prefersDark);
      document.documentElement.classList.toggle("dark", dark);
      document.documentElement.dataset.themeChoice = choice;
      window.localStorage.setItem("theme", choice);

      const button = document.getElementById("themeToggle");
      if (button) {
        const effective = dark ? "dark" : "light";
        button.title = choice === "system" ? `Theme: system (${effective})` : `Theme: ${choice}`;
      }
    };

    document.getElementById("themeToggle").addEventListener("click", () => {
      const current = window.localStorage.getItem("theme") ?? "system";
      const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
      applyTheme(next);
    });

    // Live-follow OS preference while in system mode
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", () => {
        if ((window.localStorage.getItem("theme") ?? "system") === "system") {
          applyTheme("system");
        }
      });
  })();
</script>
